# 컨테이너 환경변수로 주입한다. 실제 .env는 저장소에 올리지 않는다.
DATABASE_URL=postgresql+psycopg://townsignal:townsignal@localhost:5432/townsignal
APP_ENV=local
CORS_ORIGINS=http://localhost:5173

# api와 batch 모두 쓴다. batch는 공고 구조화 · 요약 생성, api는 자격증 정규화 LLM 폴백.
# 프론트에는 절대 내려보내지 않는다.
LLM_API_KEY=

# batch 전용. 공공데이터 원천 수집(K-Startup 오픈API 등).
PUBLIC_DATA_API_KEY=

# api 전용. 관리자 API의 X-Admin-Token 헤더 검증값.
ADMIN_TOKEN=
