# 운영 EC2의 ~/townsignal/.env 양식. 실제 값은 서버에만 두고(chmod 600) 저장소에 올리지 않는다.
# compose.prod.yml이 이 파일을 읽는다.

# ECR 주소(<AWS 계정 ID>.dkr.ecr.ap-northeast-2.amazonaws.com). 이미지 주소 앞부분이다
ECR_REGISTRY=

# DB 비밀번호. DATABASE_URL 안에 그대로 들어가므로 영문 · 숫자만 쓴다(@ : / 같은 기호 금지)
POSTGRES_PASSWORD=

# 운영은 Vercel rewrites로 같은 출처라 사실상 쓰지 않는다. Vercel 주소만 넣어 둔다
CORS_ORIGINS=

# api(자격증 정규화 폴백) · batch(공고 구조화) 공용. 프론트에 절대 내려보내지 않는다
LLM_API_KEY=

# batch 전용. 공공데이터 원천 수집(K-Startup 오픈API 등)
PUBLIC_DATA_API_KEY=

# api 전용. 관리자 API의 X-Admin-Token 검증값
ADMIN_TOKEN=
