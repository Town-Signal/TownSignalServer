# 배치 이미지 — 학습·예측 라이브러리를 포함한다. API 이미지와 분리해 API를 가볍게 유지한다.
# 실행 예: docker run <image> batch.jobs.build_support_program
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TZ=Asia/Seoul

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/ requirements/
RUN pip install --no-cache-dir -r requirements/batch.txt

COPY common/ common/
COPY batch/ batch/

ENTRYPOINT ["python", "-m"]
CMD ["batch.jobs.build_support_program"]
